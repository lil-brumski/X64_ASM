{
    "version": 8,
    "configurePresets": [
        {
            "name": "x64-asm-build",
            "binaryDir": "${sourceDir}/build/Release",
            "displayName": "GitHub/GitLab CI/CD",
            "description": "Preset to use with remote repositories like GitHub and GitLab",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "BUILD_LEARN_CMAKE_CPP": "ON",
                "BUILD_LEARN_CMAKE_CPP_2": "ON",
                "BUILD_LEARN_CMAKE_ASM": "ON",
                "ENABLE_IPO": "OFF",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        }
    ]
}
